{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rutaexpress-gt",
  "compatibility_date": "2026-08-10",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "vars": {
    // URL del tunel de Cloudflare (cambia si se recrea el contenedor cloudflared)
    "API_ORIGIN": "https://substances-stylus-affiliation-exception.trycloudflare.com"
  },
  "observability": { "enabled": true }
}
