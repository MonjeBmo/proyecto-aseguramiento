# ============================================================
# RutaExpress GT — Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rutaexpress
DB_USER=postgres
DB_PASSWORD=postgres

# Servidor backend
PORT=3000
NODE_ENV=development

# Seguridad — cambia este valor antes de cualquier despliegue
JWT_SECRET=cambia_esto_en_produccion_minimo_32_caracteres

# App movil — URL del backend
# Para Expo en dispositivo fisico: usa tu IP local (ipconfig / ifconfig)
# Para emulador Android: usa 10.0.2.2 en lugar de localhost
API_URL=http://192.168.1.X:3000
